# Copy this file to run/.env and adjust it for your environment.
MM_SCENARIO="server"
MM_INIT="init"
MM_UID="1000"
MM_GID="1000"
MM_CHMOD="777"

MM_IMAGE="karsten13/magicmirror:latest"
LABWC_IMAGE="karsten13/labwc:latest"
MMPM_IMAGE="karsten13/mmpm:latest"
WATCHTOWER_IMAGE="containrrr/watchtower:latest"

MM_SERVER_PORTS="18089:8080"
ELECTRON_ENABLE_GPU=0

MM_DIR="/opt/magic_mirror"
MM_MODULES_DIR="modules"
MM_CUSTOMCSS_FILE="css/custom.css"

VOLUME_CONFIG="../../mounts/config:${MM_DIR}/config"
VOLUME_MODULES="../../mounts/${MM_MODULES_DIR}:${MM_DIR}/${MM_MODULES_DIR}"
VOLUME_CSS="../../mounts/${MM_CUSTOMCSS_FILE}:${MM_DIR}/${MM_CUSTOMCSS_FILE}"

MM_CLIENT_PORT="8080"
MM_CLIENT_ADDRESS="192.168.0.1"

MM_MMPM="no"
MM_LABWC="no"
LAB_WC_SOCK_DIR="${XDG_RUNTIME_DIR:-/tmp/labwc}"
LAB_WC_HIDE_CURSOR="true"
RANDR_PARAMS=""
RANDR_POLL="1m"

MM_OVERRIDE_DEFAULT_MODULES="true"
MM_SHOW_CURSOR="false"
COMPOSE_PROJECT_NAME=magicmirror

MM_WATCHTOWER="no"
MM_WATCHTOWER_INTERVAL=300
MM_WATCHTOWER_CLEANUP="--cleanup"

# Google Calendar's "Secret address in iCal format". Never commit run/.env.
GOOGLE_CALENDAR_ICAL_URL="https://calendar.google.com/calendar/ical/REPLACE_ME/basic.ics"

# Weather forecast location.
WEATHER_LATITUDE="34.8164"
WEATHER_LONGITUDE="135.5686"
